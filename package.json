{
  "name": "spt-mod-manager",
  "version": "0.6.1",
  "description": "A Mod Manager for SPT",
  "license": "MIT",
  "author": "TioEmir",
  "keywords": [
    "spt",
    "single-player-tarkov",
    "mod-manager",
    "electron",
    "tarkov"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "teste": "tsx testes/testeArvore.ts && tsx testes/testePeVersion.ts && tsx testes/testeCache.ts && tsx testes/testeDeteccao.ts && tsx testes/testeCompat.ts && tsx testes/testeJson.ts && tsx testes/testeMetadata.ts && tsx testes/testeDependencias.ts && tsx testes/testeRemocaoPacote.ts && tsx testes/testeMarcacaoInstalado.ts && tsx testes/verificaTraducoes.ts",
    "preversion": "npm run teste"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "electron-store": "^8.2.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.emir.sptmodmanager",
    "productName": "SPT Mod Manager",
    "copyright": "Copyright © 2026 TioEmir",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SPT-Mod-Manager-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SPT Mod Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false
    }
  }
}
